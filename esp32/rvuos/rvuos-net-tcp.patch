diff --git a/user/wifi/net.c b/user/wifi/net.c
index 5e95821..92e6d9d 100644
--- a/user/wifi/net.c
+++ b/user/wifi/net.c
@@ -186,6 +186,20 @@ static void ip_send(struct net *n, uint8_t *f, const uint8_t *mac, uint32_t to,
     eth_send(n, f, mac, ETH_IP, IP_HEADER + len);
 }
 
+int net_ip_send(struct net *n, uint32_t to, uint32_t proto, const uint8_t *payload, uint32_t len)
+{
+    const uint8_t *mac;
+    if (len > NET_FRAME_MAX - ETH_HEADER - IP_HEADER || next_hop(n, to, &mac) != 0) {
+        return -1;
+    }
+    uint8_t *f = n->buffer(n);
+    if (f != 0) {
+        memcpy(f + ETH_HEADER + IP_HEADER, payload, len);
+        ip_send(n, f, mac, to, proto, len);
+    }
+    return 0;
+}
+
 static uint16_t udp_checksum(uint32_t from, uint32_t to, const uint8_t *udp, uint32_t len)
 {
     uint8_t pseudo[12];
@@ -454,6 +468,8 @@ static void ip_input(struct net *n, const uint8_t *eth, const uint8_t *p, uint32
         icmp_input(n, from, p + ihl, total - ihl);
     } else if (p[9] == IP_UDP) {
         udp_input(n, from, to, p + ihl, total - ihl);
+    } else if (p[9] == 6 && to == n->ip && n->tcp_input != 0) {
+        n->tcp_input(n, n->tcp_arg, from, p + ihl, total - ihl);
     }
 }
 
